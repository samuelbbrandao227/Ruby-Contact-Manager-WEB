<h1>Lista de Contatos</h1>

<%= link_to "Novo Contato", new_contact_path %>

<table>
  <thead>
    <tr>
      <th>Nome</th>
      <th>Telefone</th>
      <th>Ações</th>
    </tr>
  </thead>

  <tbody>
    <% @contacts.each do |contact| %>
      <tr>
        <td><%= contact.name %></td>
        <td><%= contact.phone %></td>
        <td>
          <%= link_to "Ver", contact %>
          <%= link_to "Editar", edit_contact_path(contact) %>
          <%= button_to "Excluir", contact,
              method: :delete,
              data: { confirm: "Tem certeza?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>